// <auto-generated />
{% if asset == "staysail" %}
// Baked by mss assets bake staysail from the Mk.{{ cut }} Blender authoring mesh.
{% else %}
// Baked by mss assets bake flying_sail from the Flying Sail Blender authoring mesh.
{% endif %}
// Supplies fresh normalized positions, planar UVs and fixed topology for each cut.
using UnityEngine;

namespace {{ namespace }}
{
    internal static class {{ class_name }}
    {
        internal static {{ data_type }} Create() =>
            new {{ data_type }}
            {
{% for name, kind, values in arrays %}
                {{ name }} = new {{ kind }}[]
                {
{% for value in values %}
                    {{ value }},
{% endfor %}
                },
{% endfor %}
            };
{% if animated %}
        internal static FishermansStaysailAnimationData CreateAnimation() =>
            new FishermansStaysailAnimationData
            {
                CornerIndices = new int[] { 0, 24, 800, 824 },
                ReefFractions = new float[] { {{ reef_fractions }} },
{% for name, frames in channels %}
                {{ name }} = new Vector3[][]
                {
{% for frame in frames %}
                    // Blender frame {{ frame }}.
                    new Vector3[]
                    {
{% for point in poses[frame] %}
                        {{ point }},
{% endfor %}
                    },
{% endfor %}
                },
{% endfor %}
            };
{% endif %}
    }
}
